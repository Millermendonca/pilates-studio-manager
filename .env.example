# ==============================================================================
# CONFIGURAÇÕES DE PRODUÇÃO - STUDIO PILATES
# ==============================================================================

# 1. BANCO DE DADOS (PostgreSQL na Nuvem obrigatório para produção com TLS/SSL)
# Exemplos: Render Postgres / Neon / Supabase
# Exemplo Neon/Supabase: postgresql://usuario:senha@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://usuario:senha@host:5432/nomedobanco?sslmode=require"

# 2. URL PÚBLICA DO SISTEMA
# Em produção: https://seu-estudio.onrender.com ou https://seudominio.com.br
NEXT_PUBLIC_APP_URL="https://seu-estudio.onrender.com"

# 3. CRIPTOGRAFIA DE DADOS EM REPOUSO (AES-256-GCM / LGPD)
# Gere uma chave de 32 bytes (64 caracteres hex) usando: node scripts/generate-keys.js
DATA_ENCRYPTION_KEY="adicione_sua_chave_de_64_caracteres_hex_aqui"

# 4. CHAVES DE ASSINATURA CRIPTOGRÁFICA JWT (SESSÕES HTTP-ONLY)
# Gere chaves aleatórias longas usando: node scripts/generate-keys.js
JWT_ADMIN_SECRET="adicione_um_segredo_jwt_super_longo_para_admin"
JWT_STUDENT_SECRET="adicione_um_segredo_jwt_super_longo_para_alunos"

# 5. GATEWAYS & INTEGRAÇÕES (Opcionais - Podem ser configurados na interface)
# BANCO_INTER_CLIENT_ID=""
# BANCO_INTER_CLIENT_SECRET=""
# EVOLUTION_API_URL=""
# EVOLUTION_API_KEY=""
