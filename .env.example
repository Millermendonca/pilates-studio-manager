# ==============================================================================
# CONFIGURAÇÕES DE PRODUÇÃO - STUDIO PILATES
# ==============================================================================

# 1. BANCO DE DADOS (PostgreSQL na Nuvem recomendado para Vercel / Neon / Supabase)
# Exemplo Neon/Supabase: postgresql://usuario:senha@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
# Exemplo Local (SQLite): file:./dev.db
DATABASE_URL="postgresql://usuario:senha@host:5432/nomedobanco?sslmode=require"

# 2. URL PÚBLICA DO SISTEMA
# Em produção na Vercel: https://seu-estudio.vercel.app ou https://seudominio.com.br
NEXT_PUBLIC_APP_URL="https://seu-estudio.vercel.app"

# 3. GATEWAYS & INTEGRAÇÕES (Opcionais - Podem ser configurados direto na tela de Configurações)
# BANCO_INTER_CLIENT_ID=""
# BANCO_INTER_CLIENT_SECRET=""
# EVOLUTION_API_URL=""
# EVOLUTION_API_KEY=""
