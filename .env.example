# ==========================================
# Configurações do Banco de Dados PostgreSQL
# ==========================================

# Conexão Local com PostgreSQL (via Docker ou Servidor Local)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/pilates_db?schema=public"

# (Opcional) Conexão com o Banco PostgreSQL na Nuvem (ex: Supabase, Neon, AWS RDS, Railway)
# CLOUD_DATABASE_URL="postgresql://postgres.xxx:yyy@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?schema=public"

# ==========================================
# Sincronização Nuvem (Offline-First Sync)
# ==========================================
# URL da API do servidor online para onde o estúdio sincroniza quando há internet
CLOUD_SYNC_API_URL="https://api.studiopilates.com.br/api/sync"
CLOUD_SYNC_API_KEY="pilates_sync_secret_token_harmonia"

# Identificador único deste terminal/estúdio local
STUDIO_NODE_ID="studio-local-reception-01"

# URL da Aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3000"
