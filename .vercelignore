# Environment variables & secrets
.env*
!.env.example
*.pem
*.key
certs/

# Local databases & SQLite files (Prevent overwrite of production data)
prisma/*.db*
prisma/*.db-journal
**/*.sqlite*
**/*.db*
*.sqlite
*.sqlite3
*.sqlite*
*.db
*.db-wal
*.db-shm
*.db-journal

# Database backups and SQL dumps (Prevent accidental leak/overwrite)
backups/
**/*.bak
**/*.sql
**/*.dump
*.bak
*.sql
*.dump

# Git & Agent metadata
.git
.github
.agents
scratch/
test/
