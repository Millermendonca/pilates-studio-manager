# Database backups and SQL dumps (Prevent accidental leak/overwrite)
backups/
**/*.bak
**/*.sql
**/*.dump
*.bak
*.sql
*.dump

# Next.js build output & caches
.next
out
build
dist
.cache
*.tsbuildinfo

